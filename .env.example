# Copy to .env and replace before starting. Never commit .env.
POSTGRES_DB=kanban
POSTGRES_USER=kanban
POSTGRES_PASSWORD=
HTTP_PORT=8080

# MinIO: username >= 3 chars, password >= 8 chars. Set a unique long password.
MINIO_ROOT_USER=kanban-storage
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=kanban-attachments
# Console is published on localhost only. S3 API stays inside the Docker network.
MINIO_CONSOLE_PORT=9001
