# Copy to .env and replace before starting. Never commit .env.
POSTGRES_DB=kanban
POSTGRES_USER=kanban
POSTGRES_PASSWORD=
HTTP_PORT=8080

# MinIO: username >= 3 chars, password >= 8 chars. Set a unique long password.
MINIO_ROOT_USER=kanban-storage
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=kanban-attachments
# Console is published on localhost only. S3 API stays inside the Docker network.
MINIO_CONSOLE_PORT=9001

# UUST schedule JSON API. Update semester values when a new semester starts.
SCHEDULE_SYNC_ENABLED=false
SCHEDULE_SYNC_SOURCE_URL=https://dev.uust-time.ru/api/v/852972
SCHEDULE_SYNC_SEMESTER_ID=241
SCHEDULE_SYNC_SEMESTER_START=2026-09-01
SCHEDULE_SYNC_INTERVAL=6h
SCHEDULE_SYNC_HTTP_TIMEOUT=20s
