# По умолчанию клиент использует существующий backend через /api/v1.
VITE_API_MODE=backend
VITE_API_URL=/api/v1
# Только для локального Vite: адрес backend, префикс /api/v1 сохраняется прокси.
API_PROXY_TARGET=http://127.0.0.1:3005
# Для отдельного демонстрационного режима: VITE_API_MODE=mock.
# VITE_* встраиваются в bundle при сборке. Не помещайте сюда секреты.
